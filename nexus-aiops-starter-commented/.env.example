# WHY THIS FILE EXISTS
# ====================
# Applications need configuration values such as database URLs and service addresses.
# We keep those values OUTSIDE Python code so the same code can run in:
# - local development
# - Docker
# - Kubernetes
# - CI/CD
#
# IMPORTANT:
# This file contains EXAMPLE values only.
# Real secrets/passwords should NOT be committed to GitHub.
#
# To use locally:
# copy this file to ".env" and change values if needed.

# Which environment are we running in?
ENVIRONMENT=dev

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# PostgreSQL connection used by the shared platform.
DATABASE_URL=postgresql://nexus:nexus@postgres:5432/nexus

# Service base URLs.
# The shared API/provider layer can call these addresses.
# Later they let us switch from mocks to real services without rewriting business logic.
M1_BASE_URL=http://telemetry-intelligence:8001
M2_BASE_URL=http://anomaly-engine:8002
M3_BASE_URL=http://rca-engine:8003
M4_BASE_URL=http://decision-engine:8004
M5_BASE_URL=http://memory-copilot:8005
M6_BASE_URL=http://finops-engine:8006
